---
import Base from '../layouts/Base.astro';
import ExerciseCard from '../components/ExerciseCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';
import { EFFECTS, EFFECT_GROUPS } from '../data/effects';

const exercises = (await getCollection('exercises')).sort((a, b) => a.data.order - b.data.order);
const masters = exercises.filter((e) => e.data.category === 'master-arcane');
const lessers = exercises.filter((e) => e.data.category === 'lesser-arcane');
const doctrine = (await getCollection('doctrine')).sort((a, b) => a.data.order - b.data.order);
const glossary = await getCollection('glossary');
const groups = [...new Set(doctrine.map((d) => d.data.group ?? 'Doctrine'))];
---
<Base title="Home" section="home">
  <div class="edition-line"><span>A manuscript, opened for study</span><span>Exercises · Doctrine · Original plates</span></div>
  <section class="hero frontispiece">
    <div class="title-leaf">
      <div class="eyebrow">As orally received by</div>
      <p class="author-line">Count Stefan Colonna Walewski</p>
      <h1><span>A System of</span>Caucasian<br />Yoga</h1>
      <div class="ink-divider" aria-hidden="true">∴</div>
      <p class="lede">A practical companion to the manuscript.<br />The exercises explained. The doctrine connected.<br />The original words always within reach.</p>
      <a class="ink-button" href={url('/exercises/')}>Open the exercises <span aria-hidden="true">↗</span></a>
      <a class="text-button" href={url('/manuscript/')}>Explore the facsimile</a>
    </div>
    <figure class="frontispiece-plate">
      <div class="plate-heading"><span>Plate I</span><span>The Master System</span></div>
      <a href={url('/manuscript/20/')}><img src={url('/figures/p020-1.jpg')} alt="Walewski’s original drawing of the seated First Master Arcane, its gaze and hand position" width="748" height="432" fetchpriority="high" /></a>
      <figcaption><span aria-hidden="true">∴</span> Posture, breath &amp; attention<br /><a href={url('/exercises/first-master-arcane/')}>Study the First Master Arcane →</a></figcaption>
      <p class="plate-note">From the author's own hand<br />Manuscript page 16</p>
    </figure>
  </section>

  <div class="edition-index" aria-label="Contents of the edition">
    <a href={url('/exercises/')}><strong>{exercises.length}</strong><span>Exercises &amp; practices</span></a>
    <a href={url('/doctrine/')}><strong>{doctrine.length}</strong><span>Doctrinal themes</span></a>
    <a href={url('/glossary/')}><strong>{glossary.length}</strong><span>Words explained</span></a>
    <a href={url('/manuscript/')}><strong>128</strong><span>Facsimile pages</span></a>
  </div>

  <section class="want-box">
    <div class="eyebrow">Guide</div>
    <h2>What do you want to develop?</h2>
    <p class="muted">Pick the effect you are after; the guide lists the exercises the text assigns to it and which one to start with.</p>
    <div class="want">
      <select id="home-want" aria-label="I want to">
        <option value="">I want to…</option>
        {EFFECT_GROUPS.map((g) => <optgroup label={g}>{EFFECTS.filter((f) => f.group === g).map((f) => <option value={f.slug}>{f.want}</option>)}</optgroup>)}
      </select>
      <a class="theme-btn" href={url('/effects/')}>browse all effects</a>
    </div>
    <script define:vars={{ base: url('/effects/') }}>
      document.getElementById('home-want').addEventListener('change', (e) => { if (e.target.value) location.href = base + '#' + e.target.value; });
    </script>
  </section>

  <div class="section-h"><h2>The Seven Master Arcanes</h2><a href={url('/exercises/#master-arcane')}>All exercises →</a></div>
  <p class="muted">The core of the system, called the Short Path: seven exercises in posture, breath and attention. Begin with the Master rhythm; each arcane gives its own instructions.</p>
  <div class="grid">{masters.map((ex) => <ExerciseCard ex={ex} />)}</div>

  <div class="section-h"><h2>Lesser Arcanes and Great Exercises</h2><a href={url('/exercises/#lesser-arcane')}>All →</a></div>
  <p class="muted">Sixteen practices "for different particular purposes": the heart, will, protection, healing, inner sound, concentration and clairvoyance, dream consciousness, rejuvenation, command, mental connection.</p>
  <div class="grid">{lessers.map((ex) => <ExerciseCard ex={ex} />)}</div>

  <div class="section-h"><h2>Doctrine, by theme</h2><a href={url('/doctrine/')}>All topics →</a></div>
  <p class="muted">The theory scattered through the Introduction, the General Compendium and the notes to the exercises, regrouped so that each idea is in one place.</p>
  <div class="grid">
    {doctrine.map((d) => (
      <a class="card" href={url(`/doctrine/${d.id}/`)}>
        <div class="eyebrow">{d.data.group}</div>
        <h3>{d.data.title}</h3>
        <p>{d.data.summary}</p>
      </a>
    ))}
  </div>

  <div class="section-h"><h2>Tools</h2></div>
  <div class="grid">
    <a class="card" href={url('/glossary/')}><h3>Glossary</h3><p>{glossary.length} terms: Gaya-Lhama, Master rhythm, Sun and Moon breath, the sacred words, the body's centres, the symbols. Terms are linked automatically wherever they appear in the cards.</p></a>
    <a class="card" href={url('/manuscript/')}><h3>The manuscript, page by page</h3><p>All 128 scanned pages with a faithful transcription beside each one, navigable by chapter. The transcription keeps the author's spelling.</p></a>
    <a class="card" href={url('/search/')}><h3>Search</h3><p>Full-text search across the cards, the doctrine, the glossary and the transcription.</p></a>
    <a class="card" href={url('/about/')}><h3>About this edition</h3><p>What was done to the text, how to read the cards, what is missing from the facsimile, and a note on claims and safety.</p></a>
  </div>
</Base>
