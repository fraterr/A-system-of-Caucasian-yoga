---
import { url, CATEGORY_LABEL } from '../lib/url';
interface Props { ex: any; }
const { ex } = Astro.props;
const d = ex.data;
---
<a class="card" href={url(`/exercises/${ex.id}/`)}
   data-category={d.category} data-planes={d.planes.join(' ')} data-purpose={d.purpose.join('|')} data-title={d.title.toLowerCase()}>
  <div class="num">{d.number ?? '·'}</div>
  <div class="eyebrow">{CATEGORY_LABEL[d.category]}</div>
  <h3>{d.shortTitle ?? d.title}</h3>
  <p>{d.summary}</p>
  <div class="tags">
    {d.planes.map((p: string) => <span class={`tag plane-${p}`}>{p}</span>)}
    {d.purpose.slice(0, 3).map((p: string) => <span class="tag">{p}</span>)}
  </div>
</a>
